<template>
  <div class="page">
    <scroll class="list" scroll-y="true">
      <text class="title">Today</text>
      <div class="item">
        <text class="item-sub">Steps</text>
        <text class="value">{{ steps }}</text>
        <progress class="bar" percent="{{ stepsPct }}"></progress>
        <text class="item-sub">Goal {{ goal }}</text>
      </div>
      <div class="item">
        <text class="item-sub">Calories</text>
        <text class="value">{{ kcal }}</text>
        <progress class="bar" percent="{{ kcalPct }}"></progress>
      </div>
      <div class="item">
        <text class="item-sub">Stand hours</text>
        <text class="value">{{ stand }}</text>
      </div>
      <div class="item">
        <text class="item-sub">Heart rate</text>
        <text class="value">{{ hr }}</text>
        <text class="item-sub">Resting {{ rest }}</text>
      </div>
      <div class="item">
        <text class="item-sub">SpO2</text>
        <text class="value">{{ spo2 }}</text>
      </div>
      <div class="item">
        <text class="item-sub">Sleep</text>
        <text class="value">{{ sleep }}</text>
        <text class="item-sub">{{ sleepSpan }}</text>
      </div>
      <div class="item">
        <text class="item-sub">Band battery</text>
        <text class="value">{{ batt }}</text>
      </div>
      <text class="note">{{ updated }}</text>
    </scroll>
  </div>
</template>

<script>
import fmt from '../../common/format.js'

export default {
  private: {
    steps: '--', goal: '--', stepsPct: 0,
    kcal: '--', kcalPct: 0, stand: '--',
    hr: '--', rest: '--', spo2: '--',
    sleep: '--', sleepSpan: '', batt: '--',
    updated: 'Waiting for the phone…',
    onState: null
  },
  onInit() {
    var self = this
    this.onState = function (m) {
      if (m.t === 'state') self.show(m)
    }
    this.$app.$def.listen(this.onState)
    var s = this.$app.$def.getState()
    if (s) this.show(s)
    this.$app.$def.refresh()
  },
  onDestroy() {
    this.$app.$def.unlisten(this.onState)
  },
  show(s) {
    this.steps = fmt.num(s.steps)
    this.goal = fmt.num(s.goal)
    this.stepsPct = fmt.pct(s.steps, s.goal)
    this.kcal = s.kcal === null || s.kcal === undefined ? '--' : fmt.num(s.kcal) + ' kcal'
    this.kcalPct = fmt.pct(s.kcal, s.kcalGoal)
    this.stand = s.stand === null || s.stand === undefined
      ? '--'
      : s.stand + (s.standGoal ? ' / ' + s.standGoal : '')
    this.hr = s.hr ? s.hr + ' bpm' : '--'
    this.rest = s.rest ? s.rest + ' bpm' : '--'
    this.spo2 = s.spo2 ? s.spo2 + '%' : '--'
    this.sleep = s.sleep ? fmt.hm(s.sleep) : '--'
    this.sleepSpan = s.sleepFrom && s.sleepTo ? s.sleepFrom + ' – ' + s.sleepTo : ''
    this.batt = s.batt === null || s.batt === undefined ? '--' : s.batt + '%'
    this.updated = s.now ? 'Updated ' + fmt.ago(s.now) : ''
  }
}
</script>

<style>
@import '../../common/style.css';
.value { font-size: 34px; color: #ffffff; }
.bar { width: 100%; height: 8px; margin: 6px 0; color: #7c5cff; layer-color: #2a2838; }
</style>
