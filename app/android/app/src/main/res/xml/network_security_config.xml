<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only; trust the system CAs, never user-installed ones. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
